{
  "manifest_version": 3,
  "name": "Torrent Uploader — envoi vers la seedbox",
  "short_name": "Torrent Uploader",
  "version": "2.0.0",
  "description": "Envoie les .torrent téléchargés et les liens magnet vers l'application Torrent Uploader (seedbox ruTorrent).",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "downloads",
    "storage",
    "notifications",
    "nativeMessaging",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "Torrent Uploader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
